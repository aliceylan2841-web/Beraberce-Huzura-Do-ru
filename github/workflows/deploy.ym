name: Firebase'e Yayınla

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Kodu al
        uses: actions/checkout@v4

      - name: Node.js kur
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Firebase CLI kur
        run: npm install -g firebase-tools

      # Blaze planına geçince aşağıdaki adımı açın (başındaki # işaretlerini silin):
      # - name: Cloud Function bağımlılıklarını kur
      #   run: cd functions && npm install

      - name: Firebase kimlik bilgisini hazırla
        run: echo '${{ secrets.FIREBASE_SERVICE_ACCOUNT }}' > "$HOME/firebase-service-account.json"

      - name: Yayınla (Hosting + Firestore kuralları)
        # NOT: Cloud Functions (AI dua-doldurma özelliği) şu an listede DEĞİL,
        # çünkü bunun için Firebase Blaze planı gerekiyor. Blaze'e geçtiğinizde
        # bu satırı şuna çevirin:
        #   firebase deploy --only hosting,firestore:rules,functions --project ...
        run: firebase deploy --only hosting,firestore:rules --project "${{ secrets.FIREBASE_PROJECT_ID }}" --non-interactive
        env:
          GOOGLE_APPLICATION_CREDENTIALS: /home/runner/firebase-service-account.json
